{"id":"60390df6-0b82-4b91-b157-16ad8af1526a","rule_id":"f76d0704-274c-42bb-afd7-51e1ea0116da","name":"Script Interpreter Spawned from Microsoft Office Application","immutable":false,"rule_source":{"type":"internal"},"version":1,"revision":0,"updated_at":"2026-09-28T20:28:25.089Z","updated_by":"elastic","created_at":"2026-09-28T20:28:25.089Z","created_by":"elastic","enabled":true,"interval":"5m","from":"now-6m","to":"now","description":"Detects a script interpreter (PowerShell, Command Prompt, WScript, CScript, or MSHTA) launched as a child process of a Microsoft Office application, consistent with malicious macro execution (MITRE ATT&CK T1204.002 / T1059).","tags":["Office","MaliciousMacro"],"author":[],"license":"","threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002/"},"technique":[{"id":"T1204","name":"User Execution","reference":"https://attack.mitre.org/techniques/T1204/","subtechnique":[{"id":"T1204.002","name":"Malicious File","reference":"https://attack.mitre.org/techniques/T1204/002/"}]},{"id":"T1059","name":"Command and Scripting Interpreter","reference":"https://attack.mitre.org/techniques/T1059/","subtechnique":[]}]}],"related_integrations":[],"required_fields":[],"setup":"","false_positives":["Legitimate document automation add-ins or enterprise macro-based workflows (e.g. mail-merge scripts); VMware Tools (vmtoolsd.exe) spawning cmd.exe for guest-integration tasks is unrelated to this rule's scope but demonstrates the importance of the parent-process restriction"],"references":["https://redcanary.com/threat-detection-report/techniques/"],"risk_score":47,"risk_score_mapping":[],"severity":"medium","severity_mapping":[],"output_index":"","max_signals":100,"exceptions_list":[],"actions":[],"meta":{"kibana_siem_app_url":"http://192.168.125.12:5601/app/security"},"type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"event.code : \"1\" and process.parent.name : (\"winword.exe\" or \"excel.exe\" or \"powerpnt.exe\" or \"outlook.exe\") and process.name : (\"powershell.exe\" or \"cmd.exe\" or \"wscript.exe\" or \"cscript.exe\" or \"mshta.exe\")","filters":[]}
{"id":"2f260b1b-6a49-4dc3-a095-253a11cec8e3","rule_id":"b08fe881-6dbc-4be7-860b-b97756cf2555","name":"Suspicious Encoded PowerShell from Explorer (ClickFix Pattern)","immutable":false,"rule_source":{"type":"internal"},"version":1,"revision":0,"updated_at":"2026-09-28T20:16:56.559Z","updated_by":"elastic","created_at":"2026-09-28T20:16:56.559Z","created_by":"elastic","enabled":true,"interval":"5m","from":"now-6m","to":"now","description":"Detects PowerShell launched as a child of explorer.exe with command-line indicators of encoding or hidden-window execution, consistent with the ClickFix \"paste-and-run\" social engineering technique (Red Canary 2026 Threat Detection Report, MITRE ATT&CK T1204.004 / T1059.001)","tags":["ClickFix","PowerShell"],"author":[],"license":"","threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002/"},"technique":[{"id":"T1204","name":"User Execution","reference":"https://attack.mitre.org/techniques/T1204/","subtechnique":[{"id":"T1204.004","name":"Malicious Copy and Paste","reference":"https://attack.mitre.org/techniques/T1204/004/"}]},{"id":"T1059","name":"Command and Scripting Interpreter","reference":"https://attack.mitre.org/techniques/T1059/","subtechnique":[{"id":"T1059.001","name":"PowerShell","reference":"https://attack.mitre.org/techniques/T1059/001/"}]}]}],"related_integrations":[],"required_fields":[],"setup":"","false_positives":["Legitimate IT/help desk instructions that have end users paste and run PowerShell commands via the Run dialog"],"references":["https://redcanary.com/blog/threat-detection/2026-threat-detection-report/","https://www.microsoft.com/en-us/security/blog/2025/08/21/think-before-you-clickfix-analyzing-the-clickfix-social-engineering-technique/"],"risk_score":47,"risk_score_mapping":[],"severity":"medium","severity_mapping":[],"output_index":"","max_signals":100,"exceptions_list":[],"actions":[],"meta":{"kibana_siem_app_url":"http://